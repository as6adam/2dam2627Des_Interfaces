{
  "name": "brum-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Guía turística bilingüe de Birmingham (es/en) y diario de desarrollo.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit && node scripts/check-catalog.ts",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/2dam2627Des_Interfaces/brum-guide/",
    "preview": "vite preview",
    "preview:pages": "vite preview --base=/2dam2627Des_Interfaces/brum-guide/",
    "inventory:photos": "node scripts/inventory-photos.mjs",
    "test:e2e": "node tests/smoke.mjs",
    "test:motion": "node tests/motion.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:journal": "node tests/journal.mjs",
    "images": "node scripts/build-images.mjs",
    "check:catalog": "node scripts/check-catalog.ts",
    "report:photos": "node scripts/photo-rights-report.mjs",
    "icons": "node scripts/render-icons.mjs",
    "import:conversations": "node scripts/import-conversations.mjs"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
